# Docker 部署用（docker compose 会自动读根目录的 .env）。
#
# 服务器上：cp .env.example .env 然后填好下面三行。
# 真实的 .env 已被 .gitignore 的 `.env` / `.env.*` 规则挡住，不会提交；
# .dockerignore 也把它挡在 build context 之外 —— 两道门都要有。

# ── 前端（构建期，会打进 bundle，任何人都能从浏览器读到）────────────
# OpenHex Agent ID。**它不是密钥**：知道它只能向这个 Agent 发消息，
# 拿不到账号或工作区权限。首页点开 Agent，地址栏 /console/ 后面那一段 UUID。
VITE_OPENHEX_AGENT_ID=00000000-0000-0000-0000-000000000000

# ── 后端（运行时，只进容器环境变量，不进镜像、不进前端）─────────────
# ⚠️ 下面两个是**工作区密钥**，等同工作区全部权限。
#    · 只写在服务器的这个文件里，不要提交、不要贴到聊天里
#    · 绝不要加 VITE_ 前缀 —— 那会把它们打进静态文件，等于公开发布
#
# 工作区 API Key（sk_ + 64 位十六进制）。注意不是 mysta_ 开头的个人 Key ——
# 签发会话令牌只接受工作区 Key，而工作区 Key 只能用个人 Key 签发。
# 还没有的话：OPENHEX_API_KEY=mysta_... pnpm --filter @lto/api bootstrap -- --slug=your-workspace
OPENHEX_WORKSPACE_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENHEX_WORKSPACE_SLUG=your-workspace-slug

# ── 可选 ────────────────────────────────────────────────────
# 对外端口。服务器 80 被占用时改这里（如 8080），不用动 nginx 配置。
# WEB_PORT=80
#
# 覆盖平台 API 地址，只在自建 / 预发环境需要。
# ⚠️ 凭据跟着这个地址走 —— 指向哪，工作区 Key 就交给谁。
# OPENHEX_API_BASE=https://api.openhex.tech
